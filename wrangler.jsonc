{
  // Deployed through Cloudflare Workers Builds: the dashboard runs
  // `npm ci && npm run build`, then `npx wrangler deploy`, which reads this file.
  //
  // `name` MUST match the project name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portifolio",
  "compatibility_date": "2026-09-08",

  // No `main` script: this is a purely static site, served straight from dist/.
  // public/_headers is copied into dist/ at build time and is honoured here.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
