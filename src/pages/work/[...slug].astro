---
import WorkPage from '../../components/WorkPage.astro';
import { getWork, slugOf, type WorkEntry } from '../../i18n/work';

export async function getStaticPaths() {
  const entries = await getWork('en');
  return entries.map((entry, i) => ({
    params: { slug: slugOf(entry) },
    props: { entry, next: entries[(i + 1) % entries.length]! },
  }));
}

const { entry, next } = Astro.props as { entry: WorkEntry; next: WorkEntry };
---
<WorkPage lang="en" entry={entry} next={next} />
