---
import { site, profiles } from '../data/site';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="shell section-y">
  <div data-reveal>
    <h2 class="display text-text">{t('contact.title')}</h2>

    <a
      href={`mailto:${site.email}`}
      class="display-sm mt-12 inline-block text-text underline decoration-line decoration-1 underline-offset-8 transition-colors duration-300 hover:text-signal hover:decoration-signal"
      style="text-transform: none;"
    >
      {site.email}
    </a>

    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      {
        profiles.map((p) =>
          p.url ? (
            <li>
              <a
                href={p.url}
                rel="me noopener"
                target="_blank"
                class="chip inline-block text-text transition-colors duration-300 hover:border-signal hover:text-signal"
              >
                {p.label} ↗
              </a>
            </li>
          ) : (
            <li>
              <span class="chip inline-block">{p.label}</span>
            </li>
          )
        )
      }
    </ul>
  </div>
</section>
