---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { specialties } from '../i18n/content';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  Two real grid columns from lg up, rather than copy floated over an absolute
  image: the portrait can never creep under the headline, at any width. Below
  lg the columns collapse into a single flow, reordered so the portrait leads
  (full-bleed, under the fixed nav's scrim) and the copy follows.
-->
<section
  class="relative flex flex-col overflow-hidden lg:grid lg:min-h-svh lg:grid-cols-[1fr_minmax(0,52%)] lg:items-stretch"
>
  <div class="order-2 shell flex items-center pt-10 pb-4 lg:order-none lg:py-32">
    <div data-reveal class="w-full max-w-[42rem]">
      <p class="label flex items-center gap-2 text-signal">
        <span class="signal-pulse inline-block size-2 rounded-[2px] bg-signal"></span>
        {t('hero.available')}
      </p>

      <h1 class="display-hero mt-7 text-text">
        <span class="block">{t('hero.line1')}</span>
        <span class="block">{t('hero.line2')}</span>
      </h1>

      <p class="prose-body mt-8 max-w-[34ch] text-muted">{t('positioning.headline')}</p>

      <ul class="mt-10 flex flex-wrap gap-2" aria-label={t('hero.specialties')}>
        {specialties[lang].map((s) => <li class="chip">{s}</li>)}
      </ul>

      <p class="label mt-10">{t('hero.location')}</p>
    </div>
  </div>

  <div class="portrait relative order-1 h-[52svh] w-full select-none lg:order-none lg:mt-0 lg:h-auto">
    <Image
      src={portrait}
      alt={t('hero.portraitAlt')}
      widths={[480, 720, 960, 1358]}
      sizes="(min-width: 64rem) 52vw, 100vw"
      loading="eager"
      decoding="async"
      class="absolute inset-0 size-full object-cover object-[62%_20%] lg:object-[center_16%]"
    />
  </div>
</section>
