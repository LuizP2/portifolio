---
import type { Locale } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import { getWork, slugOf } from '../i18n/work';
import CommitGlyph from './CommitGlyph.astro';
import Rule from './Rule.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = await getWork(lang);

/**
 * The demo projects of section 7 of the brief are Phase 2 — not built yet.
 * The row stays in the index because it is in the spec, but it is marked as in
 * progress and links nowhere: nothing here claims something that does not run.
 */
const total = String(entries.length + 1).padStart(2, '0');
---

<section id="work" class="shell section-y">
  <div class="mb-14 flex items-baseline justify-between">
    <h2 class="label">{t('work.title')}</h2>
    <span class="label">01 / {total}</span>
  </div>

  <ul class="flex flex-col">
    {
      entries.map((entry, i) => (
        <li>
          <Rule />
          <a
            href={localePath(lang, `/work/${slugOf(entry)}/`)}
            class="group grid grid-cols-12 items-baseline gap-x-4 gap-y-2 py-7 transition-colors duration-300 lg:py-9"
          >
            <span class="col-span-2 lg:col-span-1">
              <span class="label block">{String(i + 1).padStart(2, '0')}</span>
              <CommitGlyph seed={i + 1} cell="5px" class="mt-2.5" />
            </span>
            <span class="label col-span-2 lg:col-span-1">{entry.data.year}</span>
            <span class="display-sm col-span-8 text-text transition-colors duration-300 group-hover:text-signal lg:col-span-4">
              {entry.data.title}
            </span>
            <span class="col-span-12 text-base text-muted lg:col-span-4 lg:text-[1.0625rem]">
              {entry.data.summary}
            </span>
            <span class="label col-span-12 lg:col-span-2 lg:text-right">{entry.data.category}</span>

            <span class="col-span-12 max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-out-expo group-hover:max-h-40 group-hover:opacity-100 group-focus:max-h-40 group-focus:opacity-100 lg:col-start-3 lg:col-span-10">
              <span class="prose-body block pt-4 text-muted">{entry.data.teaser}</span>
              <span class="label mt-3 block text-signal">{t('work.view')}</span>
            </span>
          </a>
        </li>
      ))
    }

    <li>
      <Rule />
      <div class="grid grid-cols-12 items-baseline gap-x-4 gap-y-2 py-7 lg:py-9">
        <span class="col-span-2 lg:col-span-1">
          <span class="label block">{total}</span>
          <CommitGlyph seed={entries.length + 1} cell="5px" class="mt-2.5" />
        </span>
        <span class="label col-span-2 lg:col-span-1">2026</span>
        <span class="display-sm col-span-8 text-muted lg:col-span-4">{t('work.soonTitle')}</span>
        <span class="col-span-12 text-base text-muted lg:col-span-4 lg:text-[1.0625rem]">
          {t('work.soonSummary')}
        </span>
        <span class="label col-span-12 lg:col-span-2 lg:text-right">{t('work.soonStatus')}</span>
      </div>
    </li>
  </ul>
  <Rule />
</section>
