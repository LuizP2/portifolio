---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Rule from './Rule.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  { n: '01', title: t('how.1.title'), body: t('how.1.body') },
  { n: '02', title: t('how.2.title'), body: t('how.2.body') },
  { n: '03', title: t('how.3.title'), body: t('how.3.body') },
];
---

<section class="shell section-y">
  <h2 class="label mb-12">{t('how.title')}</h2>
  <div class="flex flex-col">
    {
      items.map((item) => (
        <article>
          <Rule />
          <div data-reveal class="grid grid-cols-12 gap-x-4 gap-y-4 py-12">
            <span class="label col-span-12 md:col-span-2">{item.n}</span>
            <h3 class="display-sm col-span-12 text-text md:col-span-4">{item.title}</h3>
            <p class="prose-body col-span-12 text-muted md:col-span-6">{item.body}</p>
          </div>
        </article>
      ))
    }
    <Rule />
  </div>
</section>
