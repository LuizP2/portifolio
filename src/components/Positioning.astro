---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="shell section-y flex min-h-[80svh] items-center justify-center">
  <div data-reveal class="max-w-4xl text-center">
    <p class="display-md text-text" style="text-transform: none;">
      {t('positioning.headline')}
    </p>
    <p class="prose-body mx-auto mt-10 text-muted">{t('positioning.body')}</p>
  </div>
</section>
