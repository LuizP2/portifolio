---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="shell section-y flex min-h-[70svh] items-center justify-center">
  <div data-reveal class="max-w-4xl text-center">
    <p
      class="text-balance font-body text-[clamp(1.375rem,3vw,2.125rem)] leading-[1.45] text-text"
    >
      {t('positioning.body')}
    </p>
  </div>
</section>
