---
import { sourceRepo } from '../data/site';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import CommitGlyph from './CommitGlyph.astro';
import Rule from './Rule.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="shell pb-10">
  <Rule class="mb-8" />
  <div class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center opacity-20"
      aria-hidden="true"
    >
      <CommitGlyph seed={11} cols={44} rows={3} cell="7px" />
    </div>
    <div class="flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between">
      <p class="label">
        {t('footer.built')}{' '}
        {
          sourceRepo ? (
            <a
              href={sourceRepo}
              rel="noopener"
              target="_blank"
              class="text-text transition-colors duration-300 hover:text-signal"
            >
              {t('footer.source')} ↗
            </a>
          ) : (
            <span>{t('footer.source')}</span>
          )
        }
      </p>
      <p class="label">© {year}</p>
    </div>
  </div>
</footer>
