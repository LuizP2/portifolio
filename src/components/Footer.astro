---
import { sourceRepo } from '../data/site';
import Rule from './Rule.astro';
const year = new Date().getFullYear();
---

<footer class="shell pb-10">
  <Rule class="mb-8" />
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <p class="label">
      Built with Astro. No trackers.{' '}
      {
        sourceRepo ? (
          <a href={sourceRepo} rel="noopener" target="_blank" class="text-text hover:text-signal transition-colors duration-300">
            Source on GitHub ↗
          </a>
        ) : (
          <span>Source on GitHub</span>
        )
      }
    </p>
    <p class="label">© {year}</p>
  </div>
</footer>
