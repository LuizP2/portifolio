---
import Base from '../layouts/Base.astro';
import Rule from './Rule.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import { slugOf, type WorkEntry } from '../i18n/work';

interface Props {
  lang: Locale;
  entry: WorkEntry;
  next: WorkEntry;
}

const { lang, entry, next } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
---

<Base
  lang={lang}
  title={`${d.title} — ${site.name}`}
  description={d.problem}
  path={`/work/${slugOf(entry)}/`}
>
  <article class="shell pt-36 pb-[var(--spacing-section)]">
    <a
      href={`${localePath(lang, '/')}#work`}
      class="label transition-colors duration-300 hover:text-signal"
    >
      {t('work.back')}
    </a>

    <header data-reveal class="mt-12">
      <h1 class="display text-text">{d.title}</h1>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-1">
        <span class="label">{d.period}</span>
        <span class="label">{d.category}</span>
      </p>
    </header>

    <div class="mt-24 flex flex-col">
      <section>
        <Rule />
        <div data-reveal class="grid grid-cols-12 gap-x-4 gap-y-4 py-12">
          <h2 class="label col-span-12 md:col-span-3">{t('work.problem')}</h2>
          <p class="prose-body col-span-12 md:col-span-9">{d.problem}</p>
        </div>
      </section>

      <section>
        <Rule />
        <div data-reveal class="grid grid-cols-12 gap-x-4 gap-y-4 py-12">
          <h2 class="label col-span-12 md:col-span-3">{t('work.built')}</h2>
          <p class="prose-body col-span-12 md:col-span-9">{d.built}</p>
        </div>
      </section>

      <section>
        <Rule />
        <div data-reveal class="grid grid-cols-12 gap-x-4 gap-y-4 py-12">
          <h2 class="label col-span-12 md:col-span-3">{t('work.result')}</h2>
          <ul class="col-span-12 flex flex-col gap-4 md:col-span-9">
            {
              d.results.map((r) => (
                <li class="flex items-start gap-4">
                  <span class="mt-[0.65em] inline-block size-1.5 shrink-0 rounded-full bg-signal" />
                  <span class="text-[1.125rem] leading-[1.7]">{r}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section>
        <Rule />
        <div data-reveal class="grid grid-cols-12 gap-x-4 gap-y-4 py-12">
          <h2 class="label col-span-12 md:col-span-3">{t('work.stack')}</h2>
          <div class="col-span-12 md:col-span-9">
            <ul class="flex flex-wrap gap-2">
              {
                d.stack.map((tag) => (
                  <li class="label rounded-full border border-line bg-surface px-3 py-1.5">{tag}</li>
                ))
              }
            </ul>
            {
              d.confidential && (
                <p class="mt-8 max-w-[62ch] text-sm text-muted">{t('work.confidential')}</p>
              )
            }
          </div>
        </div>
      </section>
      <Rule />
    </div>

    <nav class="mt-24">
      <span class="label">{t('work.next')}</span>
      <a
        href={localePath(lang, `/work/${slugOf(next)}/`)}
        class="display-md mt-4 block text-text transition-colors duration-300 hover:text-signal"
      >
        {next.data.title} →
      </a>
    </nav>
  </article>
</Base>
